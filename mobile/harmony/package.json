{
  "name": "orca-mobile-harmony",
  "version": "0.0.47",
  "private": true,
  "scripts": {
    "postinstall": "patch-package && node scripts/prepare-react-native-safe-area-har.mjs && node scripts/prepare-react-native-webview-har.mjs && node scripts/prepare-harmony-profile.mjs",
    "start": "react-native start --host 127.0.0.1",
    "harmony": "react-native run-harmony --harmony-project-path . --no-packager",
    "codegen": "react-native codegen-harmony --cpp-output-path ./entry/src/main/cpp/generated --ets-output-path ./entry/src/main/ets/codegen --project-root-path .",
    "prebundle:harmony": "node scripts/harmony-release-bundle-artifact.mjs clean",
    "bundle:harmony": "react-native bundle-harmony --entry-file index.js --bundle-output entry/src/main/resources/rawfile/hermes_bundle.hbc --assets-dest entry/src/main/resources/rawfile/assets --dev false --minify true --js-engine hermes --hermesc-dir node_modules/hermes-compiler/hermesc --hermesc-options O",
    "postbundle:harmony": "node scripts/harmony-release-bundle-artifact.mjs verify",
    "test:release-scripts": "node --test scripts/verify-harmony-hap.test.mjs scripts/verify-harmony-signed-release.test.mjs scripts/verify-harmony-publish-artifacts.test.mjs scripts/mobile-harmony-release-workflow-policy.test.mjs scripts/harmony-release-signing-validation.test.mjs scripts/prepare-harmony-release.test.mjs scripts/harmony-java-argument-file.test.mjs scripts/verify-harmony-toolchain.test.mjs scripts/harmony-release-provenance.test.mjs scripts/generate-harmony-release-sbom.test.mjs scripts/generate-harmony-release-sbom-lock-graph.test.mjs scripts/verify-harmony-release-actors.test.mjs scripts/harmony-local-signing-profile-policy.test.mjs scripts/compare-harmony-hap-contents.test.mjs scripts/run-harmony-simulator-acceptance.test.mjs scripts/verify-harmony-physical-acceptance.test.mjs scripts/react-native-safe-area-har-patch.test.mjs scripts/react-native-webview-har-patch.test.mjs",
    "test:physical-acceptance": "node --test scripts/verify-harmony-physical-acceptance.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint:native": "node scripts/run-code-linter.mjs && node scripts/harmony-source-secret-guard.mjs",
    "prepare:profile": "node scripts/prepare-harmony-profile.mjs",
    "check:source-secrets": "node scripts/harmony-source-secret-guard.mjs",
    "compare:release-haps": "node scripts/compare-harmony-hap-contents.mjs",
    "prepare:release": "node scripts/prepare-harmony-release.mjs",
    "sbom:release": "node scripts/generate-harmony-release-sbom.mjs",
    "verify:release-hap": "node scripts/verify-harmony-hap.mjs",
    "verify:release-actors": "node scripts/verify-harmony-release-actors.mjs",
    "verify:physical-acceptance": "node scripts/verify-harmony-physical-acceptance.mjs",
    "verify:release-profile": "node scripts/verify-harmony-release-profile.mjs",
    "verify:release-toolchain": "node scripts/verify-harmony-toolchain.mjs",
    "acceptance:simulator": "node scripts/run-harmony-simulator-acceptance.mjs",
    "verify:signed-release": "node scripts/verify-harmony-signed-release.mjs",
    "sign:release": "node scripts/sign-harmony-release.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-oh-tpl/async-storage": "1.21.0-0.2.2",
    "@react-native-oh-tpl/react-native-gesture-handler": "2.14.17-rc.0",
    "@react-native-oh-tpl/react-native-reanimated": "3.6.4-rc.1",
    "@react-native-oh-tpl/react-native-safe-area-context": "4.7.4-0.2.1",
    "@react-native-oh-tpl/react-native-svg": "15.0.1-8",
    "@react-native-oh-tpl/react-native-webview": "13.10.3",
    "@react-native-oh/react-native-harmony": "0.84.3",
    "@xterm/addon-unicode11": "0.10.0-beta.285",
    "@xterm/addon-webgl": "0.20.0-beta.284",
    "@xterm/xterm": "6.1.0-beta.285",
    "buffer": "6.0.3",
    "i18next": "26.3.1",
    "lowlight": "3.3.0",
    "lucide-react-native": "1.14.0",
    "mermaid": "11.17.2",
    "react": "19.2.3",
    "react-i18next": "17.0.8",
    "react-native": "0.84.1",
    "react-native-gesture-handler": "2.14.1",
    "react-native-reanimated": "3.6.0",
    "react-native-safe-area-context": "4.7.4",
    "react-native-svg": "15.0.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-webview": "13.10.2",
    "tweetnacl": "1.0.3",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-oh/react-native-harmony-cli": "0.84.3",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.0",
    "esbuild": "0.25.4",
    "patch-package": "^8.0.1",
    "tar": "7.5.22",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "harmony": {
    "codegenConfig": {
      "specPaths": [
        "./src/native/NativeOrcaHarmony.ts"
      ]
    }
  }
}
